# Порт і адреса. У контейнері HOST=0.0.0.0, локально краще 127.0.0.1
PORT=3000
HOST=127.0.0.1

# Журнали: рядки JSON у stdout (pino). Рівні: fatal error warn info debug trace silent
LOG_LEVEL=info
LOG_DIR=./logs
DEBUG_ROUTES=0

# Ліміти (Zod перевіряє їх на старті: некоректне значення - помилка і вихід)
MAX_ROOMS=20
MAX_PLAYERS=8
MAX_TOTAL_PLAYERS=160
MAX_CONN_PER_IP=10

# Мережева безпека
# Дозволені Origin для WebSocket через кому. Порожньо = лише та сама адреса (Origin збігається з Host)
ALLOWED_ORIGINS=
# не-браузерні клієнти (боти, curl) Origin не шлють
ALLOW_NO_ORIGIN=1
# брати IP із X-Forwarded-For (лише за довіреним проксі: Render, Fly.io, nginx)
TRUST_PROXY=0

# Яка збірка працює (задається при збірці образу: --build-arg GIT_SHA=... APP_VERSION=...)
GIT_SHA=dev
APP_VERSION=dev
